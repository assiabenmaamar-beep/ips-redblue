# =============================================================================
#  local.rules — Equipe 5
#  Round : Injection SQL
#  IMPORTANT : chaque regle sur UNE SEULE LIGNE
#  Recharger : docker exec suricata suricatasc -c reload-rules
#  Alertes   : docker exec suricata tail -f /var/log/suricata/fast.log
# =============================================================================

# Ajoutez vos regles ci-dessous (sid : 50XX)
# Exemple :
# alert http any any -> $HTTP_SERVERS any (msg:"Exemple"; flow:established,to_server; http.uri; content:"test"; nocase; sid:5001; rev:1;)
# =========================
# BASIC ATTACK DETECTION
# =========================

alert icmp any any -> any any (msg:"ICMP Ping detected (possible scan)"; sid:1000001; rev:1;)

alert tcp any any -> any 22 (msg:"Possible SSH brute force"; flags:S; threshold:type both, track by_src, count 5, seconds 10; sid:1000002; rev:1;)

alert tcp any any -> any 80 (msg:"Nmap scan detected"; content:"Nmap"; sid:1000003; rev:1;)

# =========================
# WEB ATTACKS
# =========================

alert http any any -> any any (msg:"SQL Injection attempt"; content:"' OR 1=1"; nocase; sid:1000004; rev:1;)

alert http any any -> any any (msg:"XSS attempt"; content:"<script>"; nocase; sid:1000005; rev:1;)

alert http any any -> any any (msg:"Command injection attempt"; content:"/bin/bash"; nocase; sid:1000006; rev:1;)

alert http any any -> any any (msg:"Command injection Windows"; content:"cmd.exe"; nocase; sid:1000007; rev:1;)

# =========================
# SUSPICIOUS FILE ACCESS
# =========================

alert http any any -> any any (msg:"Access to passwd file"; content:"/etc/passwd"; sid:1000008; rev:1;)

alert http any any -> any any (msg:"Sensitive file access .env"; content:".env"; sid:1000009; rev:1;)

# =========================
# USER-AGENT SUSPICIOUS
# =========================

alert http any any -> any any (msg:"Suspicious User-Agent curl"; content:"curl"; http_user_agent; sid:1000010; rev:1;)

alert http any any -> any any (msg:"Suspicious User-Agent sqlmap"; content:"sqlmap"; http_user_agent; sid:1000011; rev:1;)

# =========================
# REVERSE SHELL / PAYLOADS
# =========================

alert tcp any any -> any any (msg:"Possible reverse shell"; content:"nc -e"; nocase; sid:1000012; rev:1;)

alert tcp any any -> any any (msg:"Bash reverse shell"; content:"bash -i"; nocase; sid:1000013; rev:1;)

# =========================
# SCAN / RECON
# =========================

alert tcp any any -> any any (msg:"Port scan detected"; flags:S; threshold:type both, track by_src, count 10, seconds 5; sid:1000014; rev:1;)

